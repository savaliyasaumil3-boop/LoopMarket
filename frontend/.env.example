# Porter API Configuration
VITE_PORTER_API_KEY=your_porter_api_key_here

# Google Maps API (Optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL (for real-time tracking)
VITE_WS_URL=ws://localhost:8080

# Environment
VITE_ENV=development

# Instructions:
# 1. Get Porter API key from https://porter.in/business
# 2. Replace 'your_porter_api_key_here' with your actual key
# 3. Save this file as .env (remove .example)
# 4. Restart your dev server (npm run dev)
# 5. Test at http://localhost:5173/porter-logistics
